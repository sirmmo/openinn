# The Slow Orbit: a bar and bunkhouse on a refuelling ring at the edge of the Tessel mining belt.
# Between dock shifts you build out the ring and refit it; at station night the airlock opens and
# pilots, miners, courier robots and the odd envoy come aboard: thirsty, hungry, tired, flat,
# bored stiff, gritty with belt dust or carrying a rad dose home.
# The economy (brewing, printing meals, growing greens, synthesising med gel, reclaiming water,
# scrubbing the air, the comfort the decor gives off) is in economy.gbx.

inn ring
    name The Slow Orbit
    grid 12 9
    entrance 6 0 airlock        # the docking airlock
    money Credits
    reputation Rating 1.5       # a delighted guest adds 1.5, a furious one takes 1.5 away
    start Credits 320
    start Rating 5
    start Fizz 10               # the tanks and lockers are stocked for the first night
    start Rations 8
    start Water 6
    nights 7                    # a season
    guests 14                   # at most this many aboard at once
    levels 2 up                 # a season: this deck and one above, by stairwells
    endless 18 14 5 30          # endless mode: a wider ring, five decks, up to 30 guests
    wall 4                      # a bulkhead between two built cells
    door 8                      # a hatch in one
end

# ---------- phases ----------

phase dock
    name Dock shift: build and refit
    build
    set Open 0
end

phase night
    name Station night: airlock open
    length 180
    open
    night
    set Open 1
    arrive 0.06 per Rating 0.003   # more ships dock as the rating climbs
end

# ---------- layers (GlassBox maps on the built cells) ----------

layer Noise
    decay 0.25
    diffuse 0.15
    max 30
    colour ff9f1c
end

# Everyone who breathes adds to it; it barely leaks away on its own, so the ring needs scrubbers
# (and the hydroponic racks and fern planters drink a little of it).
layer CO2
    decay 0.01
    diffuse 0.25
    max 40
    colour 5ee0c0
end

# What planters, lamps, screens and the drift shrine give off: the ring feels lived in. Tourists,
# envoys and pilgrims like it.
layer Comfort
    decay 0.15
    diffuse 0.1
    max 15
    colour f2c94c
end

# ---------- rooms (cost per cell built) ----------
# `finish` lines are floors the player can lay over the plain one: `finish <id> <model> <cost> <name>`.

room airlock
    name Airlock deck
    cost 6
    colour 8a93a8
    floor floor-detail
    text Where ships dock and guests come aboard. Charging posts and scrubbers fit here.
    finish plates floor 3 Bare plates
    finish chevrons floor-panel-end 4 Hazard chevrons
    finish grid floor-panel-corner 4 Corner grid
    dwellings hall corridor stairhall secret-passage           # Dwellings rooms imported as this
end

room lounge
    name Lounge
    cost 10
    colour f29b38
    floor floor-panel
    text The heart of the ring: drinks counters, mess tables, booths and grav recliners.
    finish ribbed floor-panel-straight 4 Ribbed deck
    finish inlay floor-detail 5 Inlaid plates
    finish plates floor 3 Bare plates
    dwellings living-room room *
end

room galley
    name Galley
    cost 12
    colour e4cf4a
    floor floor-panel-straight
    text Food printers and cold stores; the stout synth too, once you have the recipe.
    finish wash floor 3 Wash-down plates
    finish tiles floor-panel 4 Tiled panels
    dwellings kitchen workshop
end

room hold
    name Cargo hold
    cost 8
    colour 6b7590
    floor floor
    text Fizz tanks, cold stores, gel synthesisers and water reclaimers: the ring's stores.
    finish grip floor-detail 3 Grip plates
    finish lanes floor-panel-end 4 Loading lanes
    dwellings cellar storage vault armoury attic
end

room cabins
    name Cabins
    cost 10
    colour 5d86e0
    floor floor-panel
    text Sleep pods and cabin berths. Keep them quiet and homely.
    finish soft floor-corner 4 Soft corners
    finish quiet floor-panel-straight 4 Quiet decking
    dwellings bedroom
end

room hydro
    name Hydroponics bay
    cost 12
    colour 6fcf6b
    floor floor-panel-corner
    text Racks of greens under grow-lights: they eat CO2, and the tables serve fresh bowls instead of printed meals.
    finish drains floor-detail 3 Drain grates
    finish rows floor-panel-straight 4 Bed rows
    dwellings greenhouse
end

room medbay
    name Med bay
    cost 14
    colour e86a8a
    floor floor
    text Med pods flush the rad dose out of belt miners and salvagers; gel synthesisers keep them stocked.
    finish sterile floor-panel 4 Sterile panels
    finish ward floor-panel-corner 4 Ward grid
    dwellings laboratory
end

room viewport
    name Observation lounge
    cost 12
    colour 7a6ee0
    floor floor-panel-end
    text A long window on the belt: viewport benches and star-chart tables for the bored and the curious.
    finish dark floor 3 Dark plates
    finish ring floor-corner 5 Ring deck
    finish inlay floor-detail 5 Inlaid plates
    dwellings observatory lookout gallery
end

room simden
    name Sim den
    cost 12
    colour c04fd0
    floor floor-panel-straight
    text Game consoles and, with a licence, sim rigs. Loud: keep it away from the cabins.
    finish arena floor-panel-corner 4 Arena grid
    finish lanes floor-panel-end 4 Lit lanes
    dwellings studio trophy-room
end

room spa
    name Wash deck
    cost 12
    colour 4fb8d0
    floor floor-corner
    text Sonic showers and steam tubs scrub off the belt grime.
    finish slats floor-panel-straight 4 Steam slats
    finish wet floor 3 Wet plates
    dwellings bathroom
end

room chapel
    name Chapel of the drift
    cost 14
    colour d8c8a0
    floor floor-detail
    text A quiet room for the long-haul faithful, who keep vigil for ships lost in the drift. Needs the rite (Contracts).
    finish nave floor-panel-end 4 Nave runner
    finish quiet floor-panel 4 Quiet panels
    finish plates floor 3 Bare plates
    dwellings chapel library study
end

# ---------- needs ----------

need Thirst
    name Thirst
    urgent 50
end

need Hunger
    name Hunger
    urgent 55
end

need Rest
    name Rest
    urgent 60
end

need Charge
    name Charge
    urgent 50
end

need Boredom
    name Boredom
    urgent 55
end

need Rads
    name Rad dose
    urgent 50
end

need Grime
    name Belt grime
    urgent 55
end

# ---------- furniture and machines ----------
# Model hints are parts of the Space Station Kit (and a few of the Furniture Kit's plants, lamps
# and wash fittings): `name:x:z:degrees:scale:y`, x, z and y in cells.

unit bar
    name Drinks counter
    in lounge
    cost 50
    seats 3
    text Pours fizz. Two side by side make a long bar; a starfield screen beside it lights it up.
    model table-large computer-screen:0:-0.15:0:0.7 chair-cushion:-0.28:0.32:180 chair-cushion:0.28:0.32:180
end

unit table
    name Mess table
    in lounge
    cost 20
    seats 2
    text Serves fresh greens bowls while the racks have greens, printed meals otherwise. Three together make a mess hall; near a hydroponic rack, a garden table.
    model table chair:0:-0.3:0 chair:0:0.3:180
end

unit booth
    name Lounge booth
    in lounge viewport
    cost 45
    seats 4
    text Four seats: greens bowls or printed meals, and Tessel stout once you brew it. A glow lamp over it makes a snug.
    model table chair-cushion-headrest:-0.2:-0.33:0 chair-cushion-headrest:0.2:-0.33:0 chair-cushion-headrest:-0.2:0.33:180 chair-cushion-headrest:0.2:0.33:180
end

unit armchair
    name Grav recliners
    in lounge viewport cabins chapel
    cost 30
    seats 2
    text A cheap doze for the tired, when the pods are full.
    model chair-armrest-headrest:-0.2:0.05:180 chair-armrest-headrest:0.2:0.05:180
end

unit printer
    name Food printer
    in galley
    cost 60
    seats 0
    text Prints meals from rations while the airlock is open, and hums.
    model computer-system
end

unit locker
    name Cold store
    in galley hold
    cost 30
    seats 0
    text Buys rations from passing freighters.
    model container-wide
end

unit tanks
    name Fizz tanks
    in hold
    cost 40
    seats 0
    text Brews fizz for the drinks counters.
    model container-flat:0:-0.1 container:0.3:0.25:0:0.8
end

unit vat
    name Stout synth
    in galley hold
    cost 70
    seats 0
    text Ferments rations into Tessel stout for the booths. Needs the recipe (Contracts).
    model container:-0.2:-0.1 container-tall:0.25:0.1:90:0.8 pipe-end-colored:-0.2:0.3
end

unit scrubber
    name Air scrubber
    in airlock lounge galley cabins hydro medbay viewport simden spa chapel
    cost 25
    seats 0
    text Pulls the CO2 out of the rooms around it, for a little power.
    model container-tall pipe-ring-colored:0:0:0:1.3
end

unit charger
    name Charging post
    in airlock lounge
    cost 35
    seats 2
    text Recharges courier robots. Two side by side make a charging bay.
    model computer
end

unit stairwell
    name Stairwell
    in airlock lounge
    cost 40
    seats 0
    stairs                      # joins this cell to the deck above
    text Opens the deck above.
    model stairs:0:0.1 stairs-handrail:0:0.1
end

unit pod
    name Sleep pods
    in cabins
    cost 30
    seats 2
    text Two sleep pods. Quiet and homely cabins rest guests better.
    model bed-single-cover:-0.2:0 bed-single-cover:0.2:0
end

unit berth
    name Cabin berth
    in cabins
    cost 45
    seats 1
    text A private berth: a full night's rest. Needs cabin berths (Contracts).
    model bed-double-cover:-0.15:0
end

unit planter
    name Fern planter
    cost 18
    seats 0
    text Decor: gives off comfort and drinks a little CO2. Stands anywhere.
    model pottedPlant:-0.1:0.12:0:0.8 plantSmall1:0.28:-0.25:0:2.5 plantSmall3:-0.3:-0.3:0:2.5
end

unit lamp
    name Glow lamp
    cost 15
    seats 0
    text Decor: a warm light that gives off comfort. Stands anywhere.
    model lampRoundFloor:-0.05:0.05
end

unit screen
    name Starfield screen
    in airlock lounge cabins viewport simden medbay spa chapel
    cost 30
    seats 0
    text Decor: a slow starfield that gives off comfort, for a little power.
    model display-wall-wide:0:-0.3
end

unit hydrorack
    name Hydroponic rack
    in hydro
    cost 45
    seats 0
    text Grows greens for fresh bowls (at greens counters, mess tables and booths), and eats CO2.
    model container-flat-open:-0.22:0:0:0.9 container-flat-open:0.24:0:0:0.9 plantSmall1:-0.22:-0.18:0:2.5:0.38 plantSmall3:-0.22:0.15:0:2.5:0.38 plantSmall2:0.24:-0.15:0:2.5:0.38 plantSmall1:0.24:0.18:0:2.5:0.38
end

unit greenbar
    name Greens counter
    in hydro lounge
    cost 40
    seats 2
    text Serves fresh greens bowls, while the racks keep up. Seats two more at the racks.
    model table-large plantSmall1:-0.25:-0.1:0:2:0.3 plantSmall3:0.25:-0.1:0:2:0.3 chair-cushion:-0.22:0.33:180 chair-cushion:0.22:0.33:180
end

unit medpod
    name Med pod
    in medbay
    cost 70
    seats 1
    text Flushes a rad dose out, for a dose of med gel.
    model bed-single:-0.1:0.05 computer-screen:0.32:-0.3:0:0.6
end

unit gelsynth
    name Gel synthesiser
    in medbay hold
    cost 50
    seats 0
    text Synthesises med gel for the med pods. Beside a med pod, it makes a triage bay.
    model computer-system:0:-0.15 container:0.3:0.25:0:0.6 pipe-ring-colored:-0.3:0.25:0:0.7
end

unit viewbench
    name Viewport bench
    in viewport
    cost 35
    seats 3
    text A long cheap look at the belt for the bored. With a star-chart table near, a window seat.
    model chair-armrest-headrest:-0.32:0.1:180 chair-armrest-headrest:0:0.1:180 chair-armrest-headrest:0.32:0.1:180 rail:0:-0.4
end

unit starmap
    name Star-chart table
    in viewport lounge
    cost 55
    seats 2
    text A tour of the belt's charts: cures boredom, and the guests trade you charts for it.
    model table-display-planet:0.12:-0.12 chair:-0.4:0:90 chair:0.4:0:270
end

unit arcade
    name Game console
    in simden lounge
    cost 40
    seats 1
    text A quick, loud round for the bored. Three in a row make an arcade row.
    model computer-system:0:-0.1 chair:0:0.3:180:0.9
end

unit simrig
    name Sim rig
    in simden
    cost 90
    seats 1
    text A full sim run: the best cure for boredom on the ring. Needs a licence (Contracts).
    model computer-wide:0:-0.25 chair-armrest-headrest:0:0.15:180 display-wall:0:-0.42:0:0.8:0.35
end

unit shower
    name Sonic shower
    in spa cabins
    cost 30
    seats 1
    text A quick dry scrub: takes most of the belt grime off.
    model shower:-0.21:0.21
end

unit steam
    name Steam tub
    in spa
    cost 60
    seats 2
    text A long hot soak, for reclaimed water. Needs steam plumbing (Contracts).
    model bathtub:-0.45:0.21 pipe:0.35:-0.35 pipe-ring-colored:0.35:-0.35:0:1:0.2
end

unit reclaimer
    name Water reclaimer
    in spa hold
    cost 40
    seats 0
    text Reclaims water for the steam tubs.
    model container-tall:-0.1:0 pipe:0.3:0.3 pipe-ring:0.3:0.3:0:1:0.15 pipe-end-colored:0.3:-0.3
end

unit shrine
    name Drift shrine
    in chapel
    cost 50
    seats 3
    text A quiet vigil for the ships lost in the drift; gives off comfort. Two glow lamps near it light the vigil.
    model wall-banner:0:-0.42 container-flat:0:-0.1:0:0.7 lampRoundFloor:-0.35:0.25:0:0.7 lampRoundFloor:0.35:0.25:0:0.7
end

# ---------- services ----------
# A unit gives the first service listed here that meets the guest's need and that it can give.

service fizz
    name A bulb of fizz
    at bar
    need Thirst 60
    global Fizz in 1
    price 3
    time 4
    map Noise out 3 radius 1
end

service stout
    name A mug of Tessel stout
    at booth
    need Thirst 80
    global Stout in 1
    price 6
    time 10
    map Noise out 2 radius 1
end

service fresh
    name A fresh greens bowl
    at greenbar table booth
    need Hunger 85
    global Greens in 1
    price 7
    time 10
end

service meal
    name A printed meal
    at table booth
    need Hunger 70
    global Meals in 1
    price 5
    time 8
    map Noise out 1
end

service pod
    name A sleep pod
    at pod
    need Rest 90
    price 6
    time 50
end

service berth
    name A cabin berth
    at berth
    need Rest 100
    price 10
    time 40
end

service doze
    name A doze in a recliner
    at armchair
    need Rest 50
    price 2
    time 25
end

service charge
    name A recharge
    at charger
    need Charge 90
    price 4
    time 12
end

service stargaze
    name An hour at the viewport
    at viewbench
    need Boredom 60
    price 2
    time 25
end

service charts
    name A star-chart tour
    at starmap
    need Boredom 80
    price 5
    time 15
    map Noise out 0.5
end

service arcade
    name A round on the console
    at arcade
    need Boredom 50
    price 3
    time 8
    map Noise out 3 radius 1
end

service sim
    name A sim run
    at simrig
    need Boredom 100
    price 9
    time 20
    map Noise out 1.5
end

service vigil
    name A quiet vigil
    at shrine
    need Boredom 90
    price 2
    time 30
end

service flush
    name A rad flush
    at medpod
    need Rads 100
    global Medgel in 1
    price 12
    time 30
end

service sonic
    name A sonic shower
    at shower
    need Grime 70
    price 3
    time 6
end

service steam
    name A steam soak
    at steam
    need Grime 100
    global Water in 1
    price 7
    time 20
end

# ---------- combos: furniture that works better together ----------
# `near` is on the same deck, within that many cells (diagonals count); `near a,b 1 2` means two
# of either. The contracts can boost some (`boost` in the idle block) and unlock the sim league.
# (No `room` lines: inside a combo, `room lounge` reads as the start of a room block. The units
# that matter stand in one kind of room anyway.)

combo barlight
    name Lit counter
    text A starfield screen beside a drinks counter: fizz sells for 15% more and guests linger happily.
    at bar
    near screen 1
    price 1.15
    mood 0.03
end

combo longbar
    name Long bar
    text Two drinks counters side by side pour in two thirds of the time.
    at bar
    near bar 1
    time 0.7
end

combo messhall
    name Mess hall
    text Three mess tables together: meals come in two thirds of the time, and it gets loud.
    at table
    near table 1 2
    time 0.7
    map Noise out 0.3
end

combo garden
    name Garden table
    text A table, booth or greens counter within two cells of a hydroponic rack: a fifth dearer, and guests love it.
    at table booth greenbar
    near hydrorack 2
    price 1.2
    mood 0.04
end

combo snug
    name Lamplit snug
    text A glow lamp beside a lounge booth: everything at it sells for a quarter more.
    at booth
    near lamp 1
    price 1.25
    mood 0.03
end

combo freshair
    name Fresh-air lounge
    text Two fern planters within two cells of a counter, table or booth, and the air under 4 CO2: guests leave happier.
    at bar table booth
    near planter 2 2
    if map CO2 less 4
    mood 0.04
end

combo quietberth
    name Quiet berth
    text A pod or berth where the noise stays under 2: a third more rest, and guests wake up pleased.
    at pod berth
    if map Noise less 2
    relief 1.3
    mood 0.05
end

combo homely
    name Homely cabin
    text A pod, berth or recliner beside a fern planter or a glow lamp: guests settle in, and the cabin feels lived in.
    at pod berth armchair
    near planter,lamp 1
    mood 0.06
    map Comfort out 0.15
end

combo windowseat
    name Window seat
    text A viewport bench within two cells of a star-chart table: half as dear again, and a quarter more relief.
    at viewbench
    near starmap 2
    price 1.5
    relief 1.25
    mood 0.05
end

combo arcaderow
    name Arcade row
    text A game console with two more beside it: 30% dearer, and very loud.
    at arcade
    near arcade 1 2
    price 1.3
    mood 0.04
    map Noise out 0.5 radius 1
end

combo league
    name Sim league
    text Two sim rigs side by side with a starfield screen near, once the rating reaches 40: league nights, half as dear again. Needs the league charter (Contracts).
    at simrig
    near simrig 1
    near screen 2
    if global Rating atLeast 40
    price 1.5
    mood 0.05
end

combo triage
    name Triage bay
    text A med pod beside a gel synthesiser: flushes take 60% of the time and clear a fifth more.
    at medpod
    near gelsynth 1
    time 0.6
    relief 1.2
end

combo fernsteam
    name Fern steam
    text A shower or steam tub beside a fern planter: a fifth more relief, happier guests, and comfort all round.
    at shower steam
    near planter 1
    relief 1.2
    mood 0.07
    map Comfort out 0.2
end

combo lampvigil
    name Lamplit vigil
    text A drift shrine with two glow lamps beside it: the faithful leave glowing.
    at shrine
    near lamp 1 2
    mood 0.1
    map Comfort out 0.4 radius 1
end

combo chargebay
    name Charging bay
    text Two charging posts side by side: recharges take 60% of the time.
    at charger
    near charger 1
    time 0.6
end

# ---------- guests ----------

