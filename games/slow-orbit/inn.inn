# ---------- contracts: the incremental layer (idle.toml, params.toml, contracts.idle) ----------

idle contracts
    tick 0.25                            # seconds of the contracts per tick of station night
    share Credits                        # one account for the ring and its contracts
    feed Served served
    feed Standing happy
    feed Standing angry -0.5
    feed Charts service charts           # guests trade star charts for a tour, a sim run...
    feed Charts service sim
    feed Charts service stargaze 0.5
    feed Charts combo windowseat 0.5
    feed Charts combo league 1
    feed Favours service flush           # ... and owe you a favour for a flush or a vigil
    feed Favours service vigil
    feed Favours service steam 0.5
    feed Favours combo triage 0.5
    feed Favours combo lampvigil 0.5
    price fizz 1 + 0.5 * Still
    price meal 1 + 0.4 * Flavours
    price fresh 1 + 0.3 * NutrientFilm
    price charge 1 + 0.5 * Firmware
    price stargaze 1 + 0.5 * Lenses
    price flush 1 + 0.25 * Protocol
    price * 1 + min(0.05 * Charters, 0.5)  # prices rise with charters and shares, but only so far: purses do not
    price * 1 + min(0.1 * Shares, 0.3)
    price * 1 + 0.25 * gala
    price * 1 + min(0.002 * Charts, 0.2) * Exchange
    arrive (1 + 0.25 * Beacon + 0.25 * Chain) * (1 + hail)
    patience 1 + 0.5 * Couches
    patience 1 + 0.3 * Accord
    boost longbar 1 + 0.5 * Taproom
    boost garden 1 + 0.5 * Fernseed
    boost homely 1 + 0.5 * Fernseed
    boost fernsteam 1 + 0.5 * Fernseed
    boost freshair 1 + 0.5 * Fernseed
    boost windowseat 1 + Lenses
    boost arcaderow 1 + Scoreboard
    boost quietberth 1 + Baffles
    boost triage 1 + 0.5 * Protocol
    boost league 1 + min(Charts, 100) / 100
    unlock berth Berths
    unlock vat StoutRecipe
    unlock simrig SimLicence
    unlock steam Plumbing
    unlock chapel Rite
    unlock league League
    restart charter consortium           # selling the charter (or floating the consortium) starts the building over
end

# ---------- how it looks (read by the browser game, not by the engine) ----------

look station
    models station glb                   # web/models/station/<name>.glb: Kenney Space Station Kit (and Furniture Kit)
    characters guests glb                # web/models/guests/<name>.glb: Kenney Mini Characters
    scale 4                              # the kit's pieces are one unit wide; a cell is four
    furniture 3
    floor-y -1.17                        # the floor plates are thick: sink them to the deck
    wall wall
    inner 0.55                           # bulkheads and hatches, at this part of a wall's height
    door wall-door
    level 6                              # how far apart the decks are drawn
    window wall-window 3                 # a window on some of the back walls
    entrance wall-door-wide 1 0          # the airlock door
    background 080b17
    ground none                          # nothing under the ring but stars
    stars 900
    grid 26304f 1a2140
    edge 3d4a7a
    light dfe8ff 1c2340
    loading Pressurising the airlock
    arrive comes aboard through the airlock
    seeds orbit comet nebula airlock quasar rivet ion drift beacon hull tessel fern vigil
    levelname Deck
    wallname Bulkhead
    doorname Hatch
    idlename Contracts
    help help.html
    style style.css
end
