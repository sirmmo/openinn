end

guest pilgrim
    name Pilgrim
    weight 2
    if global Reputation atLeast 30
    purse 25 60
    stay 100 160
    patience 40
    need Wounds 0.35 25
    need Hunger 0.5 30
    need Rest 0.7 30
    need Grime 0.2 30
    dislike map Noise greater 6 0.006
    like map Cheer greater 3 0.005
    map Noise out 0.1
    model character-female-a
end

# ---------- the ledger: the incremental layer (idle.toml, params.toml, ledger.idle) ----------

idle ledger
    tick 0.25                            # seconds of the ledger per tick of the night
    share Gold                           # one purse for the inn and the ledger
    share Mushrooms                      # foragers bring mushrooms to the inn's stores
    feed Served served
    feed Renown happy                    # a happy guest spreads the word
    feed Renown angry -0.5               # an angry one unsays some of it
    feed Renown combo mimicbar 0.25      # and everyone talks about the mimic
    feed Lore service read               # guests' tales, written down
    feed Lore service chart 2
    feed Lore combo quiet 0.5
    feed Faith service blessing
    feed Faith combo candlelit 0.5
    feed Faith combo sanctified 0.5
    price ale 1 + 0.5 * Stout
    price stew 1 + 0.4 * Spices
    price tonic 1 + 0.5 * Copper
    price blessing 1 + 0.5 * Relics
    price soak 1 + 0.3 * Bathsalts
    price dice 1 + 0.3 * HouseRules
    price cards 1 + 0.3 * HouseRules
    price * 1 + 0.05 * Legend
    price * 1 + 0.1 * Guildhall + 0.1 * Charter
    price * 1 + 0.25 * lastorders
    arrive (1 + 0.25 * Signboard) * (1 + bell)
    arrive (1 + 0.25 * Criers) * (1 + 0.03 * Guide) * (1 + 0.1 * Charter)
    patience 1 + 0.5 * Benches
    patience 1 + 0.25 * Lanterns
    unlock bed Featherbeds
    unlock maptable Cartography
    unlock vault Strongroom
    unlock mimic MimicTamer
    unlock congregation Tithes
    boost snug 1 + Hearthsong
    boost steam 1 + Bathsalts
    boost candlelit 1 + 0.5 * Relics
    boost quiet 1 + 0.5 * Archive
    boost mimicbar 1 + GildedCollar
    boost hoardwatch 1 + GildedCollar
    set Blessed blessed                  # the inn's global Blessed: 1 once the house is blessed
    restart sell charter                 # selling the inn, or chartering a guild, starts the building over
end

# ---------- how it looks (read by the browser game, not by the engine) ----------

look dungeon
    models kaykit gltf                   # web/models/kaykit/<name>.gltf: KayKit Dungeon Pack
    characters guests glb                # web/models/guests/<name>.glb: Kenney Mini Characters
    wall wall
    inner 0.55                           # inner walls and doors, at this part of a wall's height
    door wall_doorway
    level 7                              # how far apart the levels are drawn
    decor torch_mounted 3 0.8 2.6 0.5    # a torch on every third north wall
    entrance stairs 0.8 0 0.8            # the stairs down from the level above, north of the door
    background 17131f
