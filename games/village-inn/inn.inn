# ---------- the market: the incremental layer (idle.toml, params.toml, market.idle) ----------

idle market
    tick 0.25                            # seconds of the market per tick of the evening
    share Silver                         # one purse for the inn and its market stall
    share Produce                        # field hands bring vegetables to the inn's stores
    feed Served served
    feed Renown happy                    # a happy guest spreads the word
    feed Renown angry -0.5               # an angry one unsays some of it
    feed Renown combo singsong 0.25      # and everyone remembers a good sing-song
    feed Renown service remount 0.5      # the king's messengers talk at court
    feed Tales service song              # songs, tales and finds, written down
    feed Tales service read
    feed Tales service curios 0.5
    feed Tales combo quiet 0.5
    feed Tales combo society 0.5
    feed Renown combo society 0.5
    feed Alms service prayer
    feed Alms combo vespers 0.5
    feed Alms combo blessed 0.5
    price ale 1 + 0.5 * Malting
    price bestale 1 + 0.5 * Malting
    price pie 1 + 0.4 * Flour
    price stew 1 + 0.2 * Flour
    price stabling 1 + 0.5 * Oats
    price remount 1 + 0.3 * Oats
    price soak 1 + 0.3 * Lavender
    price skittles 1 + 0.3 * League
    price draughts 1 + 0.3 * League
    price prayer 1 + 0.5 * Relic
    price curios 1 + 0.5 * Society
    price * 1 + 0.05 * Legacy
    price * 1 + 0.1 * Patronage + 0.1 * Warrant
    price * 1 + 0.25 * marketday
    arrive (1 + 0.25 * Signboard) * (1 + alestake)
    arrive (1 + 0.25 * Criers) * (1 + 0.03 * Carrier) * (1 + 0.1 * Warrant)
    patience 1 + 0.5 * Benches
    patience 1 + 0.25 * Lanterns
    unlock featherbed Featherbeds
    unlock posthorse RoyalPost
    unlock brewhouse Brewhouse
    unlock maypole Maypole
    unlock congregation AlmsBox
    unlock society Society
    boost fireside 1 + HarvestSongs
    boost steam 1 + Lavender
    boost herbbath 1 + Lavender
    boost vespers 1 + 0.5 * Relic
    boost quiet 1 + 0.5 * BalladBook
    boost dancing 1 + Ribbons
    boost singsong 1 + Ribbons
    set Blessed blessed                  # the inn's global Blessed: 1 once the house is blessed
    restart sell warrant                 # passing the inn on, or a royal warrant, starts the building over
    away 1000 + 4000 * Strongbox + 5000 * Countinghouse + 5000 * Lombards   # silver time away can bring
end

# ---------- how it looks (read by the browser game, not by the engine) ----------

look village
    models kaykit gltf                   # web/models/kaykit/<name>.gltf: KayKit Dungeon Pack furniture
    characters guests glb                # web/models/guests/<name>.glb: Kenney Mini Characters
    wall village/wall-cross              # half-timbered walls (web/models/village/: Kenney Fantasy Town Kit)
    window village/wall-window 3         # shuttered windows on some of the back walls
    inner 0.55                           # inner walls and doors, at this part of a wall's height
    door village/wall-doorway
    level 6                              # how far apart the floors are drawn
    entrance village/wall-door 1 0       # the front door, onto the green
    background a9d4ef                    # a summer sky
    ground 8cb85a                        # the village green
    grid 7aa64b 86b257
    edge 5f8a3a
    light fff4dc 6f8f4a
    loading Sweeping the doorstep
    arrive comes in off the green
    seeds wheatsheaf hayrick millpond maypole lantern barley cobble meadow orchard bellfry harvest tankard thatch crossroads
    levelname Floor
    idlename Market
    help help.html
    style style.css
end
