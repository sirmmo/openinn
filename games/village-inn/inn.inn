# The Wheatsheaf: an inn on the green of a village, where the king's road crosses the drovers' way.
# By day you build and furnish; at evening the door opens and the realm comes in off the green:
# farmhands and millers from the fields, peddlers with their mules, merchants on horseback,
# soldiers from the garrison, quarrymen white with dust, bards, pilgrims on their way to the
# church, scholars from the Academy and, now and then, a royal messenger who wants a fresh horse.
# The economy (the well, the kitchen garden, brewing, cooking, baking, the stables and the smell
# they make) is in economy.gbx.

inn village
    name The Wheatsheaf
    grid 12 9
    entrance 6 0 porch          # the door onto the green
    money Silver
    reputation Reputation 2     # a delighted guest adds 2, a furious one takes 2 away
    start Silver 320
    start Reputation 5
    start Ale 10                # the cellar is stocked for the first evening
    start Provisions 8
    start Water 6
    nights 7                    # a season
    guests 14                   # at most this many at once
    levels 2 up                 # a season: the ground floor and the floor above, by stairs
    endless 18 14 5 30          # endless mode: a wider plot, five floors, up to 30 guests
    wall 4                      # an inner wall between two built cells
    door 8                      # a door in one
end

# ---------- phases ----------

phase day
    name Day: build and furnish
    build
    set Night 0
end

phase night
    name Evening: the door is open
    length 180
    open
    night
    set Night 1
    arrive 0.06 per Reputation 0.003   # more travellers stop as word gets round
end

# ---------- layers (GlassBox maps on the built cells) ----------

layer Noise
    decay 0.25
    diffuse 0.15
    max 30
    colour ff9f1c
end

# Warmth: the fire pit, the kitchen range, the bread oven and the copper. Quarrymen like it.
layer Warmth
    decay 0.1
    diffuse 0.2
    max 20
    colour e4572e
end

layer Dirt
    decay 0.002
    diffuse 0.02
    max 50
    colour 7a5c3a
end

# Muck: what the stables give off. Horses earn well, but nobody wants to eat next to them: a
# stable lad's barrow clears it, strewing herbs sweeten it, and a wall with a door keeps it out.
# The vegetable patch grows faster where there is a little of it.
layer Muck
    decay 0.02
    diffuse 0.12
    max 40
    colour 9a8a3a
end

# Cheer: lanterns, flowers, banners, music and a maypole. Most guests like it.
layer Cheer
    decay 0.15
    diffuse 0.15
    max 20
    colour f2c14e
end

# ---------- rooms (cost per cell built) ----------
# `dwellings`: the rooms of a Dwellings house that import as this room.
# `finish`: floors the player can lay over the plain one (id, model, cost per cell, name).

room porch
    name Passage
    cost 6
    colour a08a68
    floor floor_wood_small:0:0:0:2
    dwellings hall corridor stairhall gallery secret-passage lookout
    text The way in from the green and the passages between the rooms. A washstand, a lantern, a
    text banner or the stairs up can stand here.
    finish flags floor_tile_large 2 Flagstones
    finish boards floor_wood_large 2 Broad boards
    finish worn floor_tile_small_broken_B:0:0:0:2 1 Worn tiles
end

room taproom
    name Common room
    cost 10
    colour c0844f
    floor floor_wood_large
    dwellings living-room room *
    text Where the village drinks and eats: the bar, trestle tables, a fire pit and a stage for
    text the bards.
    finish dark floor_wood_large_dark 3 Dark oak boards
    finish planks floor_wood_small:0:0:0:2 2 Narrow planks
    finish flags floor_tile_large 2 Flagstones
end

room kitchen
    name Kitchen
    cost 12
    colour d4a72c
    floor floor_tile_large
    dwellings kitchen workshop
    text The range cooks stew from the larder's provisions; the bread oven bakes pies from the
    text garden's vegetables.
    finish tiles floor_tile_small:0:0:0:2 2 Small tiles
    finish earth floor_dirt_large 1 Beaten earth
end

room cellar
    name Cellar
    cost 8
    colour 7a5a44
    floor floor_dirt_large
    dwellings cellar storage
    text Cool and dark: the kegs and the larder.
    finish flags floor_tile_large 3 Flagstones
    finish rocky floor_dirt_large_rocky 1 Rocky earth
end

room chamber
    name Guest chambers
    cost 12
    colour 5f86b0
    floor floor_wood_large_dark
    dwellings bedroom
    text Beds for travellers who can pay for one. Keep them quiet and sweet-smelling: upstairs is
    text quietest.
    finish oak floor_wood_large 3 Light boards
    finish planks floor_wood_small_dark:0:0:0:2 2 Narrow dark planks
end

room loft
    name Hayloft
    cost 6
    colour b39a52
    floor floor_wood_small_dark:0:0:0:2
    dwellings attic
    text Straw pallets for peddlers and anyone else with a few pennies: cheap, and warm enough.
    finish boards floor_wood_large_dark 2 Dark boards
end

room stables
    name Stables
    cost 8
    colour 8b6a3e
    floor floor_dirt_small_weeds:0:0:0:2
    dwellings armoury vault
    text Stalls, hay and water for travellers' horses and mules: it pays well, but it smells. A
    text stable lad's barrow mucks out; a wall and a door keep the smell from the common room.
    finish straw floor_dirt_large 1 Swept earth
    finish cobbles floor_tile_large_rocks 2 Cobbles
end

room yard
    name Yard and garden
    cost 4
    colour 7fae4e
    floor village/grass
    dwellings greenhouse
    text Open to the sky: the well, the vegetable patch, the herb bed, a water trough and room for
    text a maypole. Vegetables grow faster with a little muck from the stables.
    finish path floor_dirt_large 1 Beaten path
    finish cobbles floor_tile_large_rocks 2 Cobbles
end

room bathhouse
    name Bathhouse
    cost 12
    colour 4f9da6
    floor floor_tile_small:0:0:0:2
    dwellings bathroom
    text Wooden tubs and a copper to heat the water: the quarry dust comes off here.
    finish flags floor_tile_large 2 Flagstones
    finish planks floor_wood_small:0:0:0:2 2 Duckboards
end

room alley
    name Skittle alley
    cost 10
    colour a5564a
    floor floor_wood_small:0:0:0:2
    dwellings studio trophy-room
    text Skittle lanes and a draughts table for the bored. Loud: keep it away from the chambers
    text and the quiet room.
    finish dark floor_wood_large_dark 3 Dark boards
    finish flags floor_tile_large 2 Flagstones
end

room parlour
    name Quiet room
    cost 12
    colour 8a6fb0
    floor floor_wood_large_dark
    dwellings chapel library study observatory laboratory
    text A quiet room upstairs: a prayer corner for the pilgrims, books and reading desks for the
    text scholars, and a cabinet of curiosities.
    finish planks floor_wood_small:0:0:0:2 2 Narrow planks
    finish flags floor_tile_large 2 Flagstones
end

room brewhouse
    name Brewhouse
    cost 14
    colour b07a3a
    floor floor_tile_large
    text A brewer's mash tun and malt sacks: best ale for the bar, from well water. Open it at the
    text market (a brewer's licence).
    finish earth floor_dirt_large 1 Beaten earth
    finish tiles floor_tile_small:0:0:0:2 2 Small tiles
end

# ---------- needs ----------

need Thirst
    name Thirst
    urgent 50
end

need Hunger
    name Hunger
    urgent 55
end

need Rest
    name Rest
    urgent 60
end

need Grime
    name Grime
    urgent 60
end

need Boredom
    name Boredom
    urgent 55
end

# A horse to water, stable and feed: travellers want it seen to before themselves.
need Horse
    name Stabling
    urgent 50
end

# A peddler's mule or a carter's pony: a drink and a nosebag, not a stall.
need Mule
    name Fodder
    urgent 50
end

need Prayer
    name Prayer
    urgent 55
end

# ---------- furniture and stations ----------
# Model hints: KayKit's dungeon furniture, and village/: pieces of Kenney's Fantasy Town, Nature,
# Graveyard, Survival and Prototype kits and KayKit's Medieval Hexagon pack (web/models/village/).

unit bar
